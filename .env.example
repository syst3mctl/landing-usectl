# ============================================================================================
# Analytics + search ownership
# ============================================================================================
# These MUST be set in the hosting provider's environment variables (production AND preview),
# not pasted into the built HTML or a hosting dashboard — anything outside the repo/env is wiped
# by the next deploy, which is exactly how the GA tag was lost before.
#
# GA4 measurement ID: Google Analytics → Admin → Data streams → (web stream) → "G-XXXXXXXXXX".
# NEXT_PUBLIC_ is required: the tag runs in the browser. Unset ⇒ no gtag.js is loaded at all.
NEXT_PUBLIC_GA_ID=
#
# Google Search Console, "HTML tag" verification: the content="..." value of the meta tag it
# gives you (just the token, not the whole tag). Optional — the DNS-TXT method needs no var.
GOOGLE_SITE_VERIFICATION=

# ============================================================================================
# Footer "Subscribe" form — /api/subscribe forwards the visitor's address to our inbox.
# Copy this file to .env.local and fill in ONE of the two providers. With neither set the form
# still works end to end, it just logs the address to the server console instead of mailing it.

# --- Option A (simplest): web3forms.com ------------------------------------------------------
# Enter the destination address (info@usectl.com) at https://web3forms.com — the access key
# arrives by email. No account, no domain verification; submissions are forwarded to that address.
WEB3FORMS_ACCESS_KEY=

# --- Option B: resend.com --------------------------------------------------------------------
# A real transactional send. SUBSCRIBE_FROM must be on a domain verified in Resend; the default
# onboarding@resend.dev only delivers to the Resend account's own address.
RESEND_API_KEY=
SUBSCRIBE_TO=info@usectl.com
SUBSCRIBE_FROM=onboarding@resend.dev
