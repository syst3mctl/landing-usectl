# ============================================================================================
# Analytics + search ownership
# ============================================================================================
# These MUST be set in the hosting provider's environment variables (production AND preview),
# not pasted into the built HTML or a hosting dashboard — anything outside the repo/env is wiped
# by the next deploy, which is exactly how the GA tag was lost before.
#
# GA4 measurement ID: Google Analytics → Admin → Data streams → (web stream) → "G-XXXXXXXXXX".
# NEXT_PUBLIC_ is required: the tag runs in the browser. Unset ⇒ no gtag.js is loaded at all.
NEXT_PUBLIC_GA_ID=
#
# Google Search Console, "HTML tag" verification: the content="..." value of the meta tag it
# gives you (just the token, not the whole tag). Optional — the DNS-TXT method needs no var.
GOOGLE_SITE_VERIFICATION=
#
# Meta (Facebook) Pixel / dataset ID — Events Manager → Data sources → (the dataset) → its ID,
# e.g. 2506256846565789. Public, not a secret (it ships in the browser bundle either way), but it
# still lives in env so manager.usectl.com and this page can be pointed at the same dataset from
# one place per environment.
#
# NEXT_PUBLIC_ is required (the Pixel runs in the browser) and it is inlined at BUILD time, so it
# has to be set in the host env (manager platform → pod `landing-usectl`) BEFORE the build —
# setting it after a build changes nothing until the next one. Unset ⇒ no Pixel is loaded at all.
#
# It is loaded only after the visitor accepts cookies (src/lib/consent.ts). The SAME id must be
# used on manager.usectl.com, which is where CompleteRegistration is emitted — never here.
NEXT_PUBLIC_META_PIXEL_ID=

# ============================================================================================
# Footer "Subscribe" form
# ============================================================================================
# NOTHING HERE IS NEEDED for the form to work (2026-11-07). It submits straight from the browser
# to Web3Forms, with the access key in the code — `WEB3FORMS_KEY` in src/lib/nav.ts. That key is
# public by design (it is an alias for info@usectl.com, not a secret), and it has to be the
# browser: Web3Forms' free plan refuses server-side submissions.
#
# The variables below belong to /api/subscribe, which the form no longer calls. It is kept for a
# future move to Resend (or a paid Web3Forms plan) — see the comment at the top of that file.

# --- Option A: web3forms.com, SERVER-side — needs a PAID plan + server IP whitelisting --------
# Only read by /api/subscribe. On the free plan a submission from the server is rejected, which is
# why the form bypasses it. Enter the destination address at https://web3forms.com to get a key.
WEB3FORMS_ACCESS_KEY=

# --- Option B: resend.com (the intended server-side route) ------------------------------------
# A real transactional send. SUBSCRIBE_FROM must be on a domain verified in Resend; the default
# onboarding@resend.dev only delivers to the Resend account's own address.
RESEND_API_KEY=
SUBSCRIBE_TO=info@usectl.com
SUBSCRIBE_FROM=onboarding@resend.dev
